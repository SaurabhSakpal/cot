---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}
const headings = Astro.props.headings.filter(({ depth, slug }) => (depth === 2 || depth === 3) && slug !== 'footnote-label');
---
{headings.length > 0 && (
  <aside class="toc-rail">
    <details class="toc" open>
      <summary>
        <svg class="toc-icon" width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M5 9H2.5V2.5h8V5" />
          <rect x="5" y="5" width="8.5" height="8.5" rx="1" />
          <path d="M7.5 8h3.5M7.5 10.5h3.5M4.5 5h.5" />
        </svg>
        <span>Table of contents</span>
      </summary>
      <nav aria-label="Article sections">
        <ol>
          {headings.map(({ depth, slug, text }) => (
            <li class:list={[{ 'toc-subsection': depth === 3 }]}>
              <a href={`#${slug}`} data-section={slug}><span>{text}</span></a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  </aside>
)}
