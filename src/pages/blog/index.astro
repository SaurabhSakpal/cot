---
import { getPublishedBlogEntries } from '../../lib/blog';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WritingList from '../../components/WritingList.astro';
import { newestFirst } from '../../lib/content';

const posts = (await getPublishedBlogEntries()).sort(newestFirst);
---

<BaseLayout title="Blog" description="Thoughts on software engineering, exploration, and learning.">
  <h1>Blog</h1>
  <p>Thoughts on software engineering and things learned along the way.</p>
  {posts.length > 0 ? <WritingList entries={posts} /> : <p class="empty-state">No articles published yet. New thoughts will appear here.</p>}
</BaseLayout>
