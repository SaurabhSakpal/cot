---
import type { GetStaticPaths } from 'astro';
import { getPublishedBlogHistories, type PublishedBlogHistory } from '../../lib/blog';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export const getStaticPaths = (async () => {
  const histories = await getPublishedBlogHistories();
  return histories.map((history) => ({ params: { slug: history.latest.id }, props: { history } }));
}) satisfies GetStaticPaths;

interface Props { history: PublishedBlogHistory }
const { history } = Astro.props;
---

<ArticleLayout entry={history.latest} history={history} />
