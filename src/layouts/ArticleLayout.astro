---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import RevisionTimeline from '../components/RevisionTimeline.astro';
import type { PublishedBlogHistory } from '../lib/blog';
import '../styles/article.css';
import { entryDate, formatDate, type ArticleEntry } from '../lib/content';

interface Props { entry: ArticleEntry; history?: PublishedBlogHistory }

const { entry, history } = Astro.props;
const { Content, headings } = await render(entry);
const readingLayout = entry.collection !== 'adventures';
const date = entryDate(entry);
const dateLabel = entry.collection === 'experiments' ? 'Started' : 'Published';
const tags = 'tags' in entry.data ? entry.data.tags : [];
const archived = entry.collection === 'blog' && history && entry.data.version !== history.latest.data.version;
const pageTitle = archived && entry.collection === 'blog' ? `${entry.data.title} — v${entry.data.version}` : entry.data.title;
---

<BaseLayout title={pageTitle} description={entry.data.description}>
  <article class:list={['article-shell', { 'reading-layout': readingLayout, 'blog-article': entry.collection === 'blog' }]}>
    <header class="article-header">
      {archived && history && entry.collection === 'blog' && (
        <div class="revision-notice">
          You’re reading version {entry.data.version}.
          <a href={`/blog/${history.latest.id}/`}>Read the latest version (v{history.latest.data.version})</a>.
        </div>
      )}
      {entry.collection !== 'blog' && (
        <p><a href={`/${entry.collection}/`}>Back to {entry.collection}</a></p>
      )}
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
      <p class="metadata">{dateLabel} <time datetime={date.toISOString()}>{formatDate(date)}</time></p>
      {entry.collection === 'blog' && entry.data.updatedDate && (
        <p class="metadata">Updated <time datetime={entry.data.updatedDate.toISOString()}>{formatDate(entry.data.updatedDate)}</time></p>
      )}
      {entry.collection === 'experiments' && (
        <>
          <p class="metadata experiment-status">Status: {entry.data.status === 'current' ? 'Current' : 'Completed'}</p>
          {entry.data.completedDate && <p class="metadata">Completed <time datetime={entry.data.completedDate.toISOString()}>{formatDate(entry.data.completedDate)}</time></p>}
        </>
      )}
      {entry.collection === 'adventures' && <p class="metadata">Location: {entry.data.location}</p>}
      {tags.length > 0 && <p class="metadata">Tags: {tags.join(', ')}</p>}
      {entry.collection === 'blog' && history && (
        <p class="metadata">Version {entry.data.version}{!archived && ' · Latest'}</p>
      )}
    </header>
    {entry.collection === 'blog' && history && <RevisionTimeline history={history} currentVersion={entry.data.version} />}
    {entry.collection === 'blog' && entry.data.cover && (
      <Image class="article-cover" src={entry.data.cover.image} alt={entry.data.cover.alt} />
    )}
    {readingLayout && <TableOfContents headings={headings} />}
    <div class="prose"><Content /></div>
  </article>
</BaseLayout>

<script>
  import '../scripts/article';
</script>
