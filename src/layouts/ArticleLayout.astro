---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import '../styles/article.css';
import { entryDate, formatDate, type ArticleEntry } from '../lib/content';

interface Props { entry: ArticleEntry }

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const readingLayout = entry.collection !== 'adventures';
const date = entryDate(entry);
const dateLabel = entry.collection === 'experiments' ? 'Started' : 'Published';
const tags = 'tags' in entry.data ? entry.data.tags : [];
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class:list={['article-shell', { 'reading-layout': readingLayout }]}>
    <header class="article-header">
      {entry.collection !== 'blog' && (
        <p><a href={`/${entry.collection}/`}>Back to {entry.collection}</a></p>
      )}
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
      <p class="metadata">{dateLabel} <time datetime={date.toISOString()}>{formatDate(date)}</time></p>
      {entry.collection === 'blog' && entry.data.updatedDate && (
        <p class="metadata">Updated <time datetime={entry.data.updatedDate.toISOString()}>{formatDate(entry.data.updatedDate)}</time></p>
      )}
      {entry.collection === 'experiments' && (
        <>
          <p class="metadata">Status: {entry.data.status === 'current' ? 'Current' : 'Completed'}</p>
          {entry.data.completedDate && <p class="metadata">Completed <time datetime={entry.data.completedDate.toISOString()}>{formatDate(entry.data.completedDate)}</time></p>}
        </>
      )}
      {entry.collection === 'adventures' && <p class="metadata">Location: {entry.data.location}</p>}
      {tags.length > 0 && <p class="metadata">Tags: {tags.join(', ')}</p>}
    </header>
    {entry.collection === 'blog' && entry.data.cover && (
      <Image class="article-cover" src={entry.data.cover.image} alt={entry.data.cover.alt} />
    )}
    {readingLayout && <TableOfContents headings={headings} />}
    <div class="prose"><Content /></div>
  </article>
</BaseLayout>

<script>
  import '../scripts/article';
</script>
