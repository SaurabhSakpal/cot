---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  landing?: boolean;
}

const { title, description, landing = false } = Astro.props;
const links = [
  ['/blog/', 'Blog'],
  ['/experiments/', 'Experiments'],
  ['/adventures/', 'Travel'],
  ['/about/', 'About'],
];
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/SpaceGrotesk.ttf" as="font" type="font/ttf" crossorigin />
    <meta name="description" content={description} />
    <title>{title === 'Chain of Thoughts' ? title : `${title} | Chain of Thoughts`}</title>
  </head>
  <body class:list={[{ 'mesh-home': landing }]}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
      <a class="site-name" href="/">Chain of Thoughts</a>
      <nav aria-label="Main navigation">
        <ul>
          {links.map(([href, label]) => (
            <li><a href={href} aria-current={pathname === href || pathname.startsWith(href) ? 'page' : undefined}>{label}</a></li>
          ))}
        </ul>
      </nav>
      </div>
    </header>
    <main id="main" tabindex="-1" class:list={[{ 'mesh-main': landing }]}><slot /></main>
    <footer class="site-footer"><p>Chain of Thoughts — a personal space for thinking, making, and exploring.</p></footer>
    <script>
      const header = document.querySelector<HTMLElement>('.site-header');
      if (header) {
        new ResizeObserver(() => {
          document.documentElement.style.setProperty('--header-height', `${header.getBoundingClientRect().height}px`);
        }).observe(header);
      }
    </script>
  </body>
</html>
